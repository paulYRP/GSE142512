Package: GSE142512
Type: Package
Title: 450K and EPIC Methylation ExperimentHub Data from GEO
Version: 0.99.1
Authors@R: person("Paul", "Ruiz", role = c("aut", "cre"),
            email = "ruizpint@qut.edu.au",
            comment = c(ORCID = "0009-0007-6714-3566"))
Description: Provides ExperimentHub access to processed DNA methylation
    resources derived from GEO accession GSE142512. The resources contain
    Illumina HumanMethylation450 and Infinium MethylationEPIC data represented
    as RangedSummarizedExperiment objects with beta, M, and CN assays, hg19
    genomic ranges, and sample phenotype metadata.
URL: https://github.com/paulYRP/GSE142512
BugReports: https://github.com/paulYRP/GSE142512/issues
License: Artistic-2.0
Depends:
    R (>= 4.4.0)
Imports:
    ExperimentHub,
    utils
Suggests:
    BiocStyle,
    ExperimentHubData,
    knitr,
    rmarkdown,
    SummarizedExperiment,
    testthat (>= 3.0.0)
VignetteBuilder: knitr
Config/testthat/edition: 3
biocViews: ExperimentData, ExperimentHub, GEO, Homo_sapiens_Data,
    MethylationArrayData, MicroarrayData, Tissue
Encoding: UTF-8
NeedsCompilation: no
